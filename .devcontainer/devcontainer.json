{
  "name": "Cancer Fingerprints",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": {
    "app": "uv run --no-sync streamlit run app/streamlit_app.py --server.headless true --server.enableCORS false --server.enableXsrfProtection false"
  },
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "Cancer Fingerprints app",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {
        "python.terminal.activateEnvironment": false
      }
    }
  }
}
